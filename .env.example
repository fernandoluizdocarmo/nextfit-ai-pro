# Exemplo de Arquivo .env
# Copie este arquivo para .env e preencha os valores

# Groq API Key - Obtenha em https://console.groq.com
# Free tier: mais de 10,000 requests/dia
GROQ_API_KEY=gsk_seu_valor_aqui

# Porta (opcional - padrão 3000)
PORT=3000

# Ambiente (development ou production)
NODE_ENV=development

# URL Externa (para keep-alive no Render)
# Render configura automaticamente
# RENDER_EXTERNAL_URL=https://seu-app.onrender.com
